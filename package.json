{
  "name": "@rootprint-io/quickwit-js",
  "version": "0.5.0",
  "description": "TypeScript client for Quickwit: search, ingest, index management, and tracing APIs",
  "license": "MIT",
  "author": "Oleksandr Zhyhalo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rootprint/quickwit-js.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/rootprint/quickwit-js",
  "type": "module",
  "sideEffects": [
    "./src/**"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "quickwit",
    "search",
    "logs",
    "tracing",
    "jaeger",
    "opentelemetry",
    "otlp",
    "sdk",
    "typescript",
    "client"
  ],
  "scripts": {
    "build": "bun run build:esm && bun run build:cjs && bun run build:types",
    "build:esm": "bun build ./src/index.ts --outdir ./dist --target=node --format=esm",
    "build:cjs": "bun build ./src/index.ts --outfile ./dist/index.cjs --target=node --format=cjs",
    "build:types": "dts-bundle-generator -o ./dist/index.d.ts ./src/index.ts && cp dist/index.d.ts dist/index.d.cts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests/unit.test.ts",
    "test:integration": "bun test --timeout 30000 tests/integration.test.ts",
    "prepublishOnly": "bun run typecheck && bun run build && bun test tests/unit.test.ts && node -e \"import('./dist/index.js').then(m => { if (!m.QuickwitClient) throw new Error('dist/index.js exports nothing') })\" && node -e \"if (!require('./dist/index.cjs').QuickwitClient) throw new Error('dist/index.cjs exports nothing')\""
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "dts-bundle-generator": "^9.5.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "dts-bundle-generator": {
      "typescript": "^6.0.3"
    }
  }
}
